rules_version = '2';

// 방랑자의 그늘쉼터 — Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙 에 붙여넣고 '게시'.
//
// 원칙: 누구나 읽고 새 글을 쓸 수 있되, 수정·삭제는 아무도 못 한다.
// 예외: 관리자(아래 UID)만 제보의 상태를 바꾸거나 지울 수 있다(제보 탭 맨 아래 '관리').
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 구글 계정 UID. src/content.json 의 reports.adminUids 와 같게 넣는다.
    // UID 는 제보 탭 '관리'로 로그인하면 화면 아래에 나온다.
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['7QEaxHBkuySDQTvDn5nvJzIVztE2'];
    }

    // 방명록
    match /guestbook/{doc} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 오류 제보
    match /reports/{doc} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly([
          'game', 'type', 'title', 'body', 'nickname',
          'patchVersion', 'status', 'createdAt', 'attachUrl', 'attachCount'
        ])
        && request.resource.data.game is string
        && request.resource.data.game.size() > 0
        && request.resource.data.game.size() <= 60
        && request.resource.data.type in ['진행 불가', '글자 깨짐', '번역 수정', '기타']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 30
        && request.resource.data.patchVersion is string
        && request.resource.data.patchVersion.size() > 0   // 버전 필수
        && request.resource.data.patchVersion.size() <= 20
        // 클라이언트는 상태를 정할 수 없다. 항상 '접수' 로만 들어온다.
        && request.resource.data.status == '접수'
        && request.resource.data.createdAt == request.time
        // 첨부 링크는 선택. 있으면 http(s) 주소, 500자 이내만.
        && (!('attachUrl' in request.resource.data)
            || (request.resource.data.attachUrl is string
                && request.resource.data.attachUrl.size() <= 500
                && request.resource.data.attachUrl.matches('https?://[^ ]+')))
        // 올릴 파일 개수(선택). 첨부 웹앱이 이 개수까지만 받는다.
        && (!('attachCount' in request.resource.data)
            || (request.resource.data.attachCount is int
                && request.resource.data.attachCount >= 1
                && request.resource.data.attachCount <= 7));
      // 관리자는 상태(와 바꾼 시각)만 바꿀 수 있다. 제보 내용은 못 고친다.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt'])
        && request.resource.data.status in ['접수', '확인 중', '수정 완료', '보류']
        && request.resource.data.statusAt == request.time;
      allow delete: if isAdmin();
    }
  }
}
